# AgencyOS — environment variables
#
# Setup:   cp .env.example .env.local   and fill in the values below.
# .env.local is gitignored. Never commit real keys.
#
# Every variable here is validated at boot by src/lib/env.ts. A missing or
# malformed value fails fast with a readable message rather than surfacing as a
# confusing runtime error later.

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE  —  required for Feature 1
#
# Create a project at https://supabase.com/dashboard (region: ap-south-1 /
# Mumbai), then find these under:  Project Settings → API Keys
# ─────────────────────────────────────────────────────────────────────────────

# "Project URL". Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key — "sb_publishable_..."
# (older projects call this the anon / public key, a long "eyJ..." JWT)
# Safe to expose to the browser: it is powerless without a Row Level Security
# policy that grants access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key — "sb_secret_..."  (older projects: the service_role JWT)
# ⚠️ BYPASSES ROW LEVEL SECURITY. Server-only, never sent to the browser.
# Used in exactly four places (ARCHITECTURE.md §7.3): cron handlers, webhook
# handlers, the job runner, and migration scripts.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# JOB RUNNER  —  required for Feature 6 (AI Requirement Collection)
#
# Shared secret authenticating POST /api/jobs/run, the only place the
# service-role client may execute an agent run (ARCHITECTURE.md §7.3).
#
# Leave unset and the runner returns 503 rather than running unauthenticated:
# a deployment that has not configured it is inert, not open. Minimum 16 chars.
#
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH  —  required for Feature 3 (internal staff sign-in)
#
# These are NOT read by the app. Supabase performs the OAuth exchange, so the
# credentials are configured in the dashboard, not here:
#   Authentication → Sign In / Providers → Google
#
# In Google Cloud Console, the authorised redirect URI must be:
#   https://<project-ref>.supabase.co/auth/v1/callback
#
# Listed for the record so the setup is discoverable from one place.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# NOT YET USED — added by later features. Left here as a map, not a TODO.
#
#   Feature 3 (Auth)          GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
#   Feature 6 (AI)            ANTHROPIC_API_KEY, OPENAI_API_KEY,
#                             AI_DAILY_BUDGET_MINOR
#   Feature 7 (WhatsApp)      WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID,
#                             WHATSAPP_VERIFY_TOKEN, WHATSAPP_APP_SECRET
#   Post-MVP (Finance)        RAZORPAY_KEY_ID, RAZORPAY_SECRET,
#                             RAZORPAY_WEBHOOK_SECRET
#   Post-MVP (Platform)       RESEND_API_KEY
# ─────────────────────────────────────────────────────────────────────────────
