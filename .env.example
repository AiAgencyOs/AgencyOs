# Environment variables example for AgencyOS

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# OpenAI / Anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# WhatsApp Business
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=

# OAuth
GOOGLE_CLIENT_ID=

# Optional runtime overrides
NODE_ENV=development
PORT=3000

