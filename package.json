{
  "name": "agencyos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import ./tests/_alias.mjs --test \"tests/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --linked --schema public --schema core --schema audit --schema crm --schema sales --schema projects --schema finance --schema ai > src/lib/db/types.ts",
    "db:verify": "node scripts/verify-schema.mjs",
    "db:verify:billing": "node scripts/verify-milestone-invoicing.mjs",
    "db:verify:unlock": "node scripts/verify-milestone-unlock.mjs",
    "db:verify:reaper": "node scripts/verify-job-reaper.mjs",
    "db:verify:ingest": "node scripts/verify-whatsapp-ingest.mjs",
    "db:verify:webhook": "node scripts/verify-whatsapp-webhook.mjs",
    "verify:db:up": "supabase start && supabase db reset",
    "verify:db:down": "supabase stop",
    "verify:dev": "set -a && . ./.env.verify.local && set +a && next dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "supabase": "^2.112.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
